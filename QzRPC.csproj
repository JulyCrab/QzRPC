<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Windows-only packaging: the Win32 manifest and .ico are ignored on macOS/Linux.
         Scope them to Windows targets so non-Windows publishes build cleanly.
         The empty-RID case keeps icon/manifest for local Windows dev and IDE design builds. -->
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">Assets\musical-notes.ico</ApplicationIcon>

    <!-- Self-Contained Deployment -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Assembly Metadata -->
    <AssemblyName>QzRPC</AssemblyName>
    <Product>QzRPC</Product>
    <AssemblyTitle>Unofficial Rich Presence client for a music streaming service</AssemblyTitle>
    <Description>Unofficial Rich Presence client for a music streaming service</Description>
    <Company>JulyCrab</Company>
    <Authors>JulyCrab</Authors>
    <Copyright>Copyright (c) 2026 JulyCrab</Copyright>
    
    <!-- Version Information -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    
    <!-- Additional Info -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Release Configuration: Disable debug symbols for distribution -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Don't copy reference-related .pdb/.xml files into the output. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Native debug symbols (e.g. libSkiaSharp.pdb, libHarfBuzzSharp.pdb) arrive as native
       runtime assets, so the property above does not remove them. Strip any stray .pdb from
       the Release publish output so distributions don't ship ~100 MB of unused symbols. -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbs)" />
  </Target>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
  </ItemGroup>
</Project>
